{
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true
  },
  "html.validate.scripts": false,
  "html.validate.styles": false,
  "javascript.validate.enable": true,
  "css.lint.unknownAtRules": "ignore",
  "css.lint.duplicateProperties": "warning",
  "sonarlint.rules": {
    "Web:PageWithoutTitleCheck": {
      "level": "off"
    },
    "Web:ImgWithoutAltCheck": {
      "level": "off"
    },
    "Web:S1134": {
      "level": "off"
    },
    "Web:ColorCheck": {
      "level": "off"
    },
    "Web:DuplicateIdCheck": {
      "level": "off"
    },
    "Web:FieldsetWithoutLegendCheck": {
      "level": "off"
    },
    "Web:LabelHasAssociatedControlCheck": {
      "level": "off"
    },
    "Web:BoldAndItalicTagsCheck": {
      "level": "off"
    },
    "Web:S5256": {
      "level": "off"
    },
    "CSS:S4666": {
      "level": "off"
    },
    "CSS:S4667": {
      "level": "off"
    },
    "CSS:DuplicatePropertyCheck": {
      "level": "off"
    },
    "javascript:S1134": {
      "level": "off"
    },
    "css:S7924": {
      "level": "off"
    },
    "Web:S6853": {
      "level": "off"
    }
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "cSpell.language": "de,en",
  "cSpell.enabled": true,
  "cSpell.enableFiletypes": [
    "javascript",
    "html",
    "css"
  ],
  "cSpell.words": [
    "audioanalyse",
    "echtzeitanalyse",
    "farbverlauf",
    "farbwähler",
    "geschwindigkeit",
    "helligkeit",
    "lautstärke",
    "mikrofon",
    "musikbibliothek",
    "sättigung",
    "tonhöhe",
    "überblenden",
    "visualizer",
    "wiedergabe",
    "zufallswiedergabe"
  ]
}
