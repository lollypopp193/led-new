{
    "extends": ["html-validate:recommended"],
    "rules": {
        "no-inline-style": "off",
        "no-raw-characters": "off",
        "require-button-type": "off",
        "button-has-type": "off",
        "no-missing-references": "off",
        "wcag/h37": "off",
        "wcag/h32": "off",
        "element-permitted-content": "off",
        "element-required-content": "off"
    }
}